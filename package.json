{
  "name": "reinos-de-la-frontera",
  "private": true,
  "version": "0.1.0",
  "description": "Reinos de la Frontera — MMORTS web 3D por temporadas (MVP 1 + MVP 2 táctico)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev:api": "pnpm --filter @reinos/api dev",
    "dev:worker": "pnpm --filter @reinos/worker dev",
    "dev:web": "pnpm --filter @reinos/web dev",
    "dev:battle": "pnpm --filter @reinos/battle-server dev",
    "db:generate": "pnpm --filter @reinos/db generate",
    "db:migrate": "pnpm --filter @reinos/db migrate",
    "db:seed": "pnpm --filter @reinos/db seed",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "pnpm -r build",
    "assets:validate": "pnpm --filter @reinos/asset-pipeline validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
