{
  "name": "@reinos/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proceso worker de eventos vencidos sobre PostgreSQL (ADR-0003).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "node ../../scripts/bundle.mjs src/main.ts dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@reinos/core": "workspace:*",
    "@reinos/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
