# DESARROLLO SOLAMENTE. Copiar a .env y cambiar claves antes de usar.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://reinos_dev:reinos_dev_change_me@127.0.0.1:5432/reinos_dev
APP_BASE_URL=http://localhost:5173,http://127.0.0.1:5173
API_BASE_URL=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ASSET_BASE_URL=http://localhost:5173/assets

# --- MVP 2: entrenamiento táctico (battle-server Colyseus) ---
# Valores SOLO para desarrollo local. En producción, gestor de secretos (ADR-0026).
TACTICAL_TRAINING_ENABLED=true
TACTICAL_BATTLES_ENABLED=false
TACTICAL_MAX_ROOMS=2
BATTLE_SERVER_PORT=2567
BATTLE_SERVER_HOST=127.0.0.1
BATTLE_SERVER_INTERNAL_URL=http://127.0.0.1:2567
# El navegador entra por el proxy de Vite (/battle); en producción, wss://… detrás del proxy TLS.
BATTLE_SERVER_PUBLIC_URL=/battle
BATTLE_INTERNAL_API_URL=http://127.0.0.1:3000
BATTLE_TICKET_SIGNING_KEY=dev-only-ticket-signing-key-change-me-0001
BATTLE_INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token-change-me
