{
  "name": "@reinos/asset-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contrato de manifest de assets 3D e inspección/validación automática de GLB (ADR-0008).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
